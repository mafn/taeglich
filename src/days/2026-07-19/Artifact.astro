---
import SiteLinks from "../../components/SiteLinks.astro";
import "@fontsource/vt323/latin-400.css";
---

<div class="counter" lang="de">
  <nav aria-label="Site" class="site-links">
    <SiteLinks
      linkClass="text-[0.6rem] uppercase tracking-[0.08em] text-[#d8d5cc] underline decoration-[#d8d5cc]/35 underline-offset-4 hover:text-white hover:decoration-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      separatorClass="text-[#88857d]"
    />
  </nav>
  <article class="receipt" aria-labelledby="receipt-title">
    <div class="receipt-inner">
      <header>
        <p class="brand">TÄGLICH WENIG</p>
        <h1 id="receipt-title">BETRIEBSGESELLSCHAFT MBH</h1>
        <p>Land- und forstwirtschaftlicher Nebenbetrieb</p>
        <address>
          Am Leerlauf 140<br />
          00000 Nirgendwo
        </address>
        <p>Amtsgericht Nirgendwo · HRB 404404</p>
        <p>USt-IdNr.: DE000000000</p>
      </header>

      <div class="rule"></div>
      <div class="spread strong"><span>KASSENBON</span><span>#0141</span></div>
      <div class="spread"><span>Kasse</span><span>TAEGLICH-01</span></div>
      <div class="spread"><span>Bedienung</span><span>WIEDERANFANG</span></div>
      <div class="spread">
        <span>Datum</span><time datetime="2026-07-19">19.07.2026</time>
      </div>
      <div class="spread">
        <span>Beginn</span><time datetime="2026-07-19T20:26:00+02:00"
          >20:26:00</time
        >
      </div>
      <div class="spread">
        <span>Ende</span><time datetime="2026-07-19T20:27:00+02:00"
          >20:27:00</time
        >
      </div>

      <div class="rule"></div>
      <section aria-label="Positionen" class="items">
        <div class="line-item">
          <span>1 × TAGESSEITE <small>A</small></span><span>4,20</span>
        </div>
        <div class="line-item">
          <span>1 × KLEINE IDEE <small>A</small></span><span>6,90</span>
        </div>
        <div class="line-item">
          <span>1 × STIMMUNG DES TAGES <small>B</small></span><span>3,50</span>
        </div>
        <div class="line-item">
          <span>1 × DATUM, ZUM MITNEHMEN <small>B</small></span><span>1,40</span
          >
        </div>
        <div class="line-item two-line">
          <span
            >1 × SOLARMODUL<br /><em>FÜR DEN NEUSTART</em>
            <small>C</small></span
          ><span>10,00</span>
        </div>
        <div class="line-item">
          <span>1 × WALDIDEE <small>D</small></span><span>5,55</span>
        </div>
        <div class="line-item">
          <span>1 × FREILANDSTIMMUNG <small>E</small></span><span>7,80</span>
        </div>
      </section>

      <div class="rule"></div>
      <div class="spread"><span>ZWISCHENSUMME</span><span>39,35</span></div>
      <div class="tip">
        <div class="spread strong">
          <span>PFLICHTTRINKGELD <small>A</small></span><span>55,09</span>
        </div>
        <div class="spread"><span>140,00 %</span><span>automatisch</span></div>
      </div>
      <div class="rule heavy"></div>
      <div class="spread total"><span>GESAMT</span><span>94,44 EUR</span></div>
      <div class="spread"><span>GEGEBEN BAR</span><span>100,00 EUR</span></div>
      <div class="spread"><span>RÜCKGELD</span><span>5,56 EUR</span></div>

      <div class="rule"></div>
      <table>
        <caption>Umsatzsteueraufschlüsselung</caption>
        <thead
          ><tr
            ><th abbr="Steuersatz">USt</th><th>Netto</th><th abbr="Steuerbetrag"
              >USt</th
            ><th>Brutto</th></tr
          ></thead
        >
        <tbody>
          <tr><td>A 19%</td><td>55,62</td><td>10,57</td><td>66,19</td></tr>
          <tr><td>B 7%</td><td>4,58</td><td>0,32</td><td>4,90</td></tr>
          <tr><td>C 0%</td><td>10,00</td><td>0,00</td><td>10,00</td></tr>
          <tr><td>D 5,5%</td><td>5,26</td><td>0,29</td><td>5,55</td></tr>
          <tr><td>E 7,8%</td><td>7,24</td><td>0,56</td><td>7,80</td></tr>
        </tbody>
        <tfoot
          ><tr><th>SUMME</th><th>82,70</th><th>11,74</th><th>94,44</th></tr
          ></tfoot
        >
      </table>

      <div class="rule"></div>
      <section aria-label="Technische Sicherheitseinrichtung" class="tse">
        <div class="spread"><span>Vorgang</span><span>BELEG</span></div>
        <div class="spread">
          <span>Transaktionsnr.</span><span>NICHT VERGEBEN</span>
        </div>
        <div class="spread"><span>Signaturzähler</span><span>—</span></div>
        <div class="spread"><span>Prüfwert</span><span>—</span></div>
        <p class="failure">*** TSE-AUSFALL ***</p>
        <p>
          Ausfallgrund:<br /><strong>TSE NICHT ERREICHBAR</strong>
        </p>
        <p>Letzte Transaktion:<br /><strong>22.02.2026</strong></p>
        <p>Seriennr. Kasse:<br />544145474C4943482D3031</p>
        <p class="serial">
          Seriennr. TSE:<br />00000000000000000000000000000000<br
          />00000000000000000000000000000000
        </p>
      </section>

      <div class="rule"></div>
      <footer>
        <p class="thanks">VIELEN DANK FÜR NICHTS.</p>
        <p class="next">NÄCHSTE SEITE: MORGEN</p>
        <p class="fine-print">
          Das Pflichttrinkgeld ist freiwillig verpflichtend und wurde bereits zu
          Ihrer Bequemlichkeit ausgewählt. Der Nullsteuersatz für das
          Neustartmodul gilt nur bei Montage auf oder in der Nähe einer
          Hoffnung. Die Durchschnittssätze D und E setzen eine hinreichend
          landwirtschaftliche Hoffnung voraus. Reklamationen bitte innerhalb von
          140 Tagen einreichen. Diese Frist ist bereits abgelaufen.
        </p>
      </footer>
    </div>
  </article>
</div>

<style>
  .counter {
    min-height: 100svh;
    display: grid;
    place-items: start center;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 0%, #45433e, transparent 45rem), #1e1d1a;
    padding: clamp(5rem, 8vw, 6rem) 0.75rem clamp(5rem, 9vw, 8rem);
    color: #191816;
  }

  .receipt {
    position: relative;
    width: min(100%, 29rem);
    filter: drop-shadow(0 1.5rem 1.4rem rgba(0, 0, 0, 0.45));
    transform: rotate(-0.35deg);
  }

  .receipt-inner {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(
        90deg,
        rgba(51, 56, 52, 0.035),
        transparent 8%,
        transparent 91%,
        rgba(51, 56, 52, 0.035)
      ),
      #f8f7f1;
    padding: clamp(2rem, 8vw, 3.25rem) clamp(1.15rem, 7vw, 2.4rem) 3.75rem;
    font-family: "VT323", "Courier New", monospace;
    font-size: clamp(0.94rem, 3.5vw, 1.08rem);
    line-height: 1.28;
    letter-spacing: 0.018em;
    text-shadow: 0.2px 0 currentColor;
  }

  .receipt-inner::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.12;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 4px,
      rgba(255, 255, 255, 0.72) 5px
    );
    mix-blend-mode: screen;
  }

  header,
  footer {
    text-align: center;
  }
  header p,
  header h1,
  address {
    margin: 0;
  }
  address {
    font-style: normal;
    margin: 0.65rem 0;
  }
  .brand {
    font-size: 1.45em;
    font-weight: 850;
    letter-spacing: 0.08em;
  }
  h1 {
    font-size: 0.94em;
    font-weight: 750;
    letter-spacing: 0.03em;
  }
  .rule {
    height: 1px;
    border-top: 1px dashed currentColor;
    margin: 1rem 0;
    opacity: 0.78;
  }
  .rule.heavy {
    border-top: 3px double currentColor;
    height: 3px;
  }
  .spread,
  .line-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .spread > :last-child,
  .line-item > :last-child {
    flex: none;
    text-align: right;
  }
  .strong {
    font-weight: 800;
  }
  .items {
    display: grid;
    gap: 0.72rem;
  }
  .two-line {
    align-items: end;
  }
  em {
    font-style: normal;
    padding-left: 2ch;
  }
  small {
    font: inherit;
    font-size: 0.78em;
    vertical-align: top;
  }
  .tip {
    border: 1px solid currentColor;
    padding: 0.55rem 0.65rem;
    margin: 0.8rem -0.35rem;
  }
  .total {
    align-items: baseline;
    font-size: 1.25em;
    font-weight: 900;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font: inherit;
  }
  caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  th,
  td {
    padding: 0.12rem 0;
    text-align: right;
    font-weight: 400;
  }
  th:first-child,
  td:first-child {
    text-align: left;
  }
  thead th,
  tfoot th {
    font-weight: 800;
  }
  tfoot {
    border-top: 1px solid currentColor;
  }
  .tse p {
    margin: 1rem 0 0;
  }
  .failure {
    padding: 0.45rem;
    border: 2px solid currentColor;
    text-align: center;
    font-size: 1.1em;
    font-weight: 900;
    letter-spacing: 0.06em;
  }
  .serial {
    overflow-wrap: anywhere;
  }
  .thanks {
    margin: 1.4rem 0 0;
    font-size: 1.08em;
    font-weight: 900;
  }
  .next {
    margin: 0.7rem 0 2.25rem;
    letter-spacing: 0.08em;
  }
  .fine-print {
    margin: 0;
    text-align: justify;
    font-size: 0.68em;
    line-height: 1.45;
    opacity: 0.8;
  }
  .site-links {
    position: fixed;
    z-index: 10;
    top: 1rem;
    right: 1rem;
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid rgba(216, 213, 204, 0.2);
    border-radius: 999px;
    background: rgba(30, 29, 26, 0.9);
    padding: 0.5rem 0.7rem;
  }

  @media (max-width: 25rem) {
    .receipt-inner {
      padding-inline: 0.85rem;
    }
    .brand {
      font-size: 1.25em;
    }
  }

  @media (forced-colors: active) {
    .receipt {
      filter: none;
    }
    .receipt-inner::after {
      display: none;
    }
    .receipt-inner {
      border: 2px solid CanvasText;
      background: Canvas;
      color: CanvasText;
    }
    .rule,
    .tip,
    .failure,
    tfoot,
    .site-links {
      border-color: CanvasText;
    }
    .fine-print {
      opacity: 1;
    }
  }
</style>
