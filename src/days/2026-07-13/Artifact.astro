---
import BankShell from './components/BankShell.astro';
import StartScreen from './components/StartScreen.astro';
import LoginScreen from './components/LoginScreen.astro';
import DashboardScreen from './components/DashboardScreen.astro';
import TransferScreen from './components/TransferScreen.astro';
import SiteLinks from '../../components/SiteLinks.astro';
---
<div id="game-root" class="relative min-h-screen text-slate-800 antialiased font-sans bg-slate-900 flex flex-col">
  <BankShell>
    <div id="screen-container" class="relative transition-opacity duration-300">
      <StartScreen />
      <LoginScreen />
      <DashboardScreen />
      <TransferScreen />
    </div>
  </BankShell>

  <div id="simulated-phone" class="fixed bottom-4 left-1/2 -translate-x-1/2 w-[90%] max-w-sm bg-white border border-slate-200 shadow-2xl rounded-[2rem] overflow-hidden translate-y-[120%] transition-transform motion-reduce:transition-none duration-500 z-[100]">
    <div class="bg-slate-100 p-2 text-center text-xs text-slate-500 font-medium border-b border-slate-200 flex justify-between items-center">
      <span>Messages</span>
      <button type="button" id="btn-dismiss-phone" class="text-slate-400 hover:text-slate-600 px-2 py-1" aria-label="Dismiss message">✕</button>
    </div>
    <div class="p-4 bg-white" aria-live="polite">
      <div class="text-sm text-slate-800 mb-1 font-bold">NCB Alerts</div>
      <div class="text-xs text-slate-600 font-mono mb-3">
        OTP for RTGS Transfer to A/C 11294 is <strong id="simulated-otp-code" class="text-lg text-black bg-yellow-100 px-1"></strong>. Do not share.
      </div>
    </div>
  </div>

  <div id="notification-tray" class="fixed top-4 right-4 w-72 flex flex-col gap-2 z-[110] pointer-events-none" aria-live="assertive"></div>

  <!-- Fade to Black Screen for final ending -->
  <div id="fade-screen" role="dialog" aria-modal="true" aria-labelledby="fade-title" aria-describedby="fade-desc" tabindex="-1" class="fixed inset-0 bg-black z-[1000] hidden flex-col items-center justify-center text-white opacity-0 transition-opacity duration-1000">
    <h1 id="fade-title" class="text-4xl font-black mb-4 tracking-widest uppercase focus:outline-none" tabindex="-1"></h1>
    <p id="fade-desc" class="text-slate-300 text-lg max-w-md text-center"></p>
    <button id="btn-restart" class="mt-8 px-6 py-2 border border-slate-600 hover:bg-slate-800 transition-colors hidden">Play Again</button>
  </div>

  <!-- Fake Alert Modal -->
  <div id="fake-alert-modal" role="alertdialog" aria-modal="true" tabindex="-1" class="fixed inset-0 bg-transparent z-[2000] hidden flex-col items-center justify-center">
    <div class="bg-slate-200 border-2 border-slate-400 w-80 shadow-[4px_4px_0_0_rgba(0,0,0,0.3)]">
      <div class="bg-blue-800 text-white text-xs font-bold px-2 py-1 flex justify-between items-center">
        <span>Message from webpage</span>
        <button type="button" id="btn-close-alert" class="hover:bg-red-600 px-2 font-black leading-none focus:outline-blue-500">&times;</button>
      </div>
      <div class="p-6 text-center text-sm font-sans flex flex-col items-center gap-6">
        <span id="fake-alert-msg" class="text-slate-800"></span>
        <button type="button" id="btn-ok-alert" class="px-6 py-1 bg-slate-300 border border-slate-500 shadow-[1px_1px_0_0_rgba(0,0,0,0.5)] hover:bg-slate-400 focus:outline-blue-500 active:translate-y-[1px] active:translate-x-[1px] active:shadow-none">OK</button>
      </div>
    </div>
  </div>

  <!-- Post-it Note -->
  <div id="sticky-post-it" class="fixed top-20 right-8 w-40 h-40 bg-[#fdf5b1] border border-[#d6cc81] shadow-lg transform rotate-3 z-[90] p-4 font-serif flex flex-col justify-center items-center pointer-events-none transition-all duration-500 hidden md:flex">
    <div class="text-blue-800 font-bold text-center leading-tight">
      NCB Login PIN:<br/>
      <span id="post-it-pin" class="text-3xl tracking-widest mt-2 block font-mono">1984</span>
    </div>
  </div>

  <button type="button" id="btn-pause" class="fixed bottom-4 right-4 bg-slate-800 text-white px-4 py-2 rounded-full text-xs opacity-50 hover:opacity-100 z-[200]">Pause</button>
  <footer class="mt-8 text-center pb-8 relative z-50"><SiteLinks /></footer>
</div>
<script src="./bank-machine.ts"></script>
