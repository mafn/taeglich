---
import SiteLinks from "../../components/SiteLinks.astro";

const days = Array.from({ length: 141 });
---

<article class="absence-piece" aria-describedby="absence-description">
  <div class="composition">
    <header>
      <p class="eyebrow">23.02—13.07</p>
      <h1>No backfill</h1>
    </header>

    <div class="field" aria-hidden="true">
      {
        days.map((_, index) => (
          <span class:list={["day", { present: index === days.length - 1 }]} />
        ))
      }
    </div>

    <footer class="statement">
      <p>Nothing is owed to the empty days.</p>
      <div class="footer-meta">
        <p class="date">2026-07-13 · present</p>
        <nav aria-label="Site" class="site-links">
          <SiteLinks
            linkClass="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-[#514c47] underline decoration-[#191714]/25 underline-offset-4 hover:decoration-[#191714] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#191714]"
            separatorClass="text-[#777068]"
          />
        </nav>
      </div>
    </footer>

    <p id="absence-description" class="sr-only">
      One hundred and forty outlined squares represent the unpublished days from
      February 23 through July 12. A final filled square represents July 13,
      2026.
    </p>
  </div>
</article>

<style>
  .absence-piece {
    --ink: #191714;
    --paper: #f1eee7;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 18% 12%,
        rgba(255, 255, 255, 0.9),
        transparent 32%
      ),
      var(--paper);
    color: var(--ink);
    padding: clamp(2rem, 7vw, 6rem) clamp(1.25rem, 6vw, 5rem);
  }

  .composition {
    width: min(100%, 64rem);
    display: grid;
    gap: clamp(2.25rem, 6vw, 5rem);
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
  }

  h1,
  p {
    margin: 0;
  }

  h1 {
    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(1.45rem, 4vw, 3.25rem);
    font-weight: 520;
    letter-spacing: -0.045em;
    text-transform: lowercase;
  }

  .eyebrow,
  .date {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: clamp(0.62rem, 1.2vw, 0.75rem);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .site-links {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .eyebrow {
    color: #69635d;
  }

  .field {
    display: grid;
    grid-template-columns: repeat(47, minmax(0, 1fr));
    gap: clamp(0.16rem, 0.45vw, 0.34rem);
    transform: rotate(-0.65deg);
  }

  .day {
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--ink) 24%, transparent);
    background: rgba(255, 255, 255, 0.12);
  }

  .day:nth-child(11n + 2) {
    transform: translateY(7%);
  }

  .day:nth-child(17n + 5) {
    opacity: 0.58;
  }

  .day.present {
    border-color: var(--ink);
    background: var(--ink);
    opacity: 1;
    box-shadow:
      0 0 0 1px var(--paper),
      0 0 0 2px var(--ink);
  }

  .statement {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgba(25, 23, 20, 0.2);
    padding-top: 1rem;
  }

  .statement > :first-child {
    max-width: 22ch;
    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(1.15rem, 2.5vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .date {
    flex: none;
    color: #5f5952;
  }

  .footer-meta {
    display: grid;
    justify-items: end;
    gap: 1.25rem;
  }

  @media (max-width: 40rem) {
    .field {
      grid-template-columns: repeat(16, minmax(0, 1fr));
    }

    .statement {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .footer-meta {
      justify-items: start;
    }

    .site-links {
      justify-content: flex-start;
    }
  }

  @media (prefers-contrast: more) {
    .day {
      border-color: rgba(25, 23, 20, 0.55);
    }
  }
</style>
