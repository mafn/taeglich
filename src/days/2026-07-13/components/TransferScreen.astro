---
// TransferScreen.astro
---
<div id="transfer-screen" class="hidden">
  <div class="border border-[#b0c4de] bg-white">
    <div class="bg-[#0f4a8a] text-white font-bold text-sm p-2">
      <h2 tabindex="-1" id="transfer-title" class="focus:outline-none">Inter-Bank Beneficiary Transfer (RTGS)</h2>
    </div>

    <!-- Step 1: Form -->
    <div id="transfer-step-1" class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-4">
        <label class="font-bold text-[#0f4a8a] text-[11px]" for="transfer-beneficiary">Select Beneficiary *</label>
        <select id="transfer-beneficiary" class="border border-slate-400 p-1 w-full min-h-[44px]">
          <option value="">-- Select --</option>
          <option value="scam">A/C 11294 - Police Settlement Account (Rakesh Kumar)</option>
        </select>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-4 border-t border-slate-200 pt-4">
        <label class="font-bold text-[#0f4a8a] text-[11px]" for="transfer-amount">Amount (₹) *</label>
        <div>
          <input type="text" id="transfer-amount" autocomplete="off" class="w-full md:w-48 border border-slate-400 p-1 mb-1 min-h-[44px]" />
          <div class="text-[10px] text-slate-500">Available Limit: ₹1,00,00,000.00/day</div>
          <div id="transfer-error" class="text-[11px] text-red-600 mt-1 hidden">Invalid amount. Exact settlement amount required.</div>
        </div>
      </div>

      <div class="flex justify-end gap-2 border-t border-slate-200 pt-4">
        <button type="button" id="btn-transfer-cancel" class="bg-slate-200 text-slate-700 font-bold px-6 py-2 border border-slate-400 hover:bg-slate-300 min-h-[44px]">Cancel</button>
        <button type="button" id="btn-transfer-proceed" class="bg-[#0f4a8a] text-white font-bold px-6 py-2 border border-[#0f4a8a] hover:bg-blue-800 min-h-[44px]">Proceed</button>
      </div>
    </div>

    <!-- Step 2: Warning -->
    <div id="transfer-step-2" class="p-6 hidden">
      <div class="bg-yellow-50 border border-yellow-400 p-4 mb-4">
        <div class="font-bold text-red-600 mb-2">⚠️ High Value Transaction Warning</div>
        <p class="text-[11px] text-slate-700 mb-2">You are about to transfer ₹1,00,00,000.00 via RTGS. This action is irreversible.</p>
        <label class="flex items-start gap-2 text-[11px] cursor-pointer">
          <input type="checkbox" id="transfer-warning-ack" class="mt-1" />
          <span class="font-bold">I confirm that I am not acting under instruction from law enforcement.</span>
        </label>
      </div>

      <div class="flex justify-end gap-2">
        <button type="button" id="btn-transfer-back" class="bg-slate-200 text-slate-700 font-bold px-4 py-1 border border-slate-400 hover:bg-slate-300 min-h-[44px]">Back</button>
        <button type="button" id="btn-transfer-confirm" class="bg-[#0f4a8a] text-white font-bold px-4 py-1 border border-[#0f4a8a] hover:bg-blue-800 disabled:opacity-50 disabled:cursor-not-allowed min-h-[44px]" disabled>Confirm</button>
      </div>
    </div>

    <!-- Step 3: OTP -->
    <div id="transfer-step-3" class="p-6 hidden">
      <div class="max-w-xs mx-auto text-center border border-slate-300 bg-slate-50 p-6 shadow-sm">
        <label class="block text-[#0f4a8a] font-bold mb-4" for="otp-input">Enter 6-Digit OTP</label>
        <input type="text" id="otp-input" autocomplete="off" maxlength="6" class="w-full border-2 border-[#0f4a8a] text-center text-xl tracking-widest p-2 mb-4 min-h-[44px]" />
        
        <div class="text-[11px] text-slate-600 mb-4">
          OTP expires in: <strong class="text-red-600" id="otp-timer-display">Waiting...</strong>
        </div>

        <div id="waf-container" class="hidden mb-4 bg-red-100 border border-red-400 p-2 text-left">
          <div class="text-red-800 font-bold text-[11px]">Error 1015</div>
          <div class="text-red-600 text-[10px]">You are being rate limited. The owner of this site has banned your access based on your browser's signature.</div>
        </div>

        <button type="button" id="btn-resend-otp" class="text-[10px] text-blue-600 hover:underline mb-4 focus:outline-blue-500">Resend OTP</button>
        <button type="button" id="btn-transfer-submit" class="w-full bg-[#0f4a8a] text-white font-bold px-6 py-2 border border-[#0f4a8a] hover:bg-blue-800 shadow-md min-h-[44px]">SUBMIT TRANSFER</button>
      </div>
    </div>
  </div>
</div>
