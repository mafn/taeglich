---
// EndingScreen.astro
---
<div id="ending-screen" class="hidden min-h-screen flex items-center justify-center bg-slate-100 p-4 font-sans text-slate-900 absolute inset-0 z-[100]" role="alert" aria-live="assertive" tabindex="-1">
  <div class="max-w-xl w-full bg-white border-4 border-slate-400 shadow-2xl overflow-hidden flex flex-col">
    <!-- Top Bar -->
    <div id="ending-header" class="bg-slate-800 text-white font-bold text-sm p-3 flex justify-between items-center">
      <span id="ending-title">Terminal State</span>
      <span class="text-xs text-slate-400">NCB Session Closed</span>
    </div>

    <!-- Content -->
    <div class="p-8">
      <div id="ending-icon" class="text-5xl mb-4 text-center" aria-hidden="true">🛑</div>
      <h2 id="ending-headline" class="text-2xl font-bold text-center mb-6 text-slate-800" tabindex="-1">Session Ended</h2>
      
      <div id="ending-body" class="bg-slate-50 border border-slate-200 p-4 mb-6 text-sm leading-relaxed text-slate-700">
        <!-- JS injects the ending text here -->
      </div>

      <div class="flex justify-center">
        <button type="button" id="btn-play-again" class="bg-slate-800 text-white font-bold py-2 px-6 hover:bg-slate-900 focus:ring-4 focus:ring-slate-300 transition-colors shadow-sm min-h-[44px]">
          Return to Start
        </button>
      </div>
    </div>
  </div>
</div>
